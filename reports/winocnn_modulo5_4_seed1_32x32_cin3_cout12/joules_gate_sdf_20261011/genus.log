@file(power.tcl) 13: set CONSTRAINTS_PATH $POWER_ROOT
@file(power.tcl) 16: proc wino_domain ...
@file(power.tcl) 23: set WINO_DOM [wino_domain $GIT_ROOT]
@file(power.tcl) 24: set TAG      "dom${WINO_DOM}"
@file(power.tcl) 25: set GOLDEN_CHECK [file join $GIT_ROOT sim_asic $TAG gate rtl_golden_check.json]
@file(power.tcl) 26: if {![file exists $GOLDEN_CHECK]} {
    error "Gate-SDF-vs-golden comparison missing at $GOLDEN_CHECK; run asic_scripts/run_gate_sim_asic.sh first"
}
@file(power.tcl) 29: set check_f [open $GOLDEN_CHECK r]
@file(power.tcl) 30: set check_json [read $check_f]
@file(power.tcl) 31: close $check_f
@file(power.tcl) 32: if {![regexp {\"result\"\s*:\s*\"PASS\"} $check_json]} {
    error "Gate-SDF-vs-golden comparison did not PASS: $GOLDEN_CHECK"
}
@file(power.tcl) 35: set DB_FILE [file join $GIT_ROOT reports genus $TAG gate_level wino_systolic_top_logic_mapped.db]
@file(power.tcl) 36: set SHM     [file join $GIT_ROOT sim_asic $TAG gate dut.shm]
@file(power.tcl) 37: set OUT_FILE [file join $GIT_ROOT reports genus $TAG wino_systolic_top_power_shm_tt.rpt]
@file(power.tcl) 38: if {![file exists $DB_FILE]} { error "Mapped Genus database missing: $DB_FILE" }
@file(power.tcl) 39: if {![file exists $SHM]} { error "Gate-level SDF SHM missing: $SHM" }
@file(power.tcl) 40: set START_TIME 0ns
@file(power.tcl) 41: puts "INFO: Winograd domain $WINO_DOM -> power report $OUT_FILE"
