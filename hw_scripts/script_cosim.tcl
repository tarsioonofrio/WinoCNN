############################################################
## WinoCNN — HLS C/RTL co-simulation for the ASIC top.
##
## Runs the self-checking C testbench (testbench/single_main.cpp, which now
## falls back to fixed default arguments) against the RTL generated by
## script_asic.tcl.  This validates the HLS RTL functionally, independently of
## the Verilog testbench used for power/traffic.
##
##   vivado_hls -f hw_scripts/script_cosim.tcl
############################################################
open_project HLS_asic
set_top wino_systolic_top
open_solution "solution_asic"
cosim_design -rtl verilog -trace_level none -tool xsim
